#!/bin/sh
# Headless Chromium with WebGPU for films with shader layers. On machines without a GPU, SwiftShader provides WebGPU on the CPU.
# The window must be larger than the 1080×1920 layer: the shaders library caps its buffer to the window's inner size.
for c in "$CHROME_BIN" /opt/pw-browsers/chromium-*/chrome-linux/chrome /usr/bin/chromium /usr/bin/google-chrome; do
  [ -n "$c" ] && [ -x "$c" ] && exec "$c" --no-sandbox --disable-dev-shm-usage --window-size=1400,2400 --enable-unsafe-webgpu \
    --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader "$@"
done
echo "no Chromium found; set CHROME_BIN" >&2; exit 1
